# -------------------------------------------------------------
# Car Researcher Environment Configuration
# -------------------------------------------------------------

# Search Constraints (Bay Area Default)
SEARCH_NAME="Bay Area EV Watchlist"
SEARCH_ZIP_CODE="94103"
SEARCH_RADIUS_MILES=60

# Budget Targets (in USD)
SEARCH_MIN_PRICE=20000
SEARCH_MAX_PRICE=60000
SEARCH_MIN_YEAR=2021
SEARCH_MAX_YEAR=2026

# Target Powertrains: BEV, PHEV, HEV, ICE
SEARCH_POWERTRAINS='["BEV"]'

# Target Vehicles JSON (Make, Model, optional Min/Max Year overrides)
# Mainstream high bang-for-buck + Upmarket luxury EV depreciation bargains
SEARCH_TARGET_MODELS='[
  {"make": "Hyundai", "model": "Ioniq 5", "min_year": 2022},
  {"make": "Hyundai", "model": "Ioniq 6", "min_year": 2023},
  {"make": "Kia", "model": "EV6", "min_year": 2022},
  {"make": "Tesla", "model": "Model Y", "min_year": 2022},
  {"make": "Tesla", "model": "Model 3", "min_year": 2022},
  {"make": "Ford", "model": "Mustang Mach-E", "min_year": 2022},
  {"make": "Chevrolet", "model": "Bolt EUV", "min_year": 2022, "max_year": 2023},
  {"make": "BMW", "model": "i4", "min_year": 2022},
  {"make": "Mercedes-Benz", "model": "EQS", "min_year": 2022},
  {"make": "Mercedes-Benz", "model": "EQE", "min_year": 2023},
  {"make": "Cadillac", "model": "Lyriq", "min_year": 2023},
  {"make": "Genesis", "model": "GV60", "min_year": 2023},
  {"make": "Polestar", "model": "2", "min_year": 2022},
  {"make": "Audi", "model": "Q4 e-tron", "min_year": 2022}
]'

# Database Configuration (PostgreSQL with TimescaleDB and pgvector)
DATABASE_URL="postgresql+asyncpg://researcher:researcher_pass@localhost:5432/researcher"
DATABASE_ECHO=false

# Temporal Orchestration Server
TEMPORAL_HOST="localhost:7233"
TEMPORAL_NAMESPACE="default"
TEMPORAL_TASK_QUEUE_DEFAULT="car-research-queue"
TEMPORAL_TASK_QUEUE_SCRAPERS="car-scraper-queue"

# Scraper Settings
SCRAPER_HEADLESS=true
SCRAPER_CONCURRENCY=3
SCRAPER_RESIDENTIAL_PROXY_URL="" # e.g. http://user:pass@proxy.example.com:8080

# Notifications (Optional)
DISCORD_WEBHOOK_URL=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
